@model Area
@{
    ViewData["Title"] = "Create Area";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        <button type="button" class="btn btn-close btn-sm close-alert" aria-label="Close alert"></button>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMenssage"] != null)
{
    <div class="alert alert-danger" role="alert">
        <button type="button" class="btn btn-close btn-sm close-alert" aria-label="Close alert"></button>
        @TempData["ErrorMenssage"]
    </div>
}
<div class="text-center">
    <h1 class="display-4">@ViewData["Title"]</h1>
</div>
<form asp-controller="Area" asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="input-group mb-3">
        <label asp-for="Name" class="input-group-text"></label>
        <input type="text" class="form-control" asp-for="Name">
        <span asp-validation-for="Name" class="input-group-text text-danger"></span>
    </div>
    <div class="mb-3 d-grid gap-2">
        <button type="submit" class="btn btn-primary">Create</button>
        <a class="btn btn-secondary" role="button" asp-controller="Area" asp-action="Index">List Area</a>
    </div>
</form>
