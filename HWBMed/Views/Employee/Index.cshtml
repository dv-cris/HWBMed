@model IEnumerable<HWBMed.Models.Employee>

@{
    ViewData["Title"] = "Employee list";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        <button type="button" class="btn btn-close btn-sm close-alert" aria-label="Close alert"></button>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        <button type="button" class="btn btn-close btn-sm close-alert" aria-label="Close alert"></button>
        @TempData["ErrorMessage"]
    </div>
}

<div class="text-center">
    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
        <a class="btn btn-primary" role="button" asp-controller="User" asp-action="Index">List Users</a>
    </div>
    <br />
    <h1 class="display-4">@ViewData["Title"]</h1>

    @(Html
    .Grid(Model)
    .Build(columns =>
    {
        columns.Add(model => model.User.Name).Titled(@Html.DisplayNameFor(model => model.User.Name));
        columns.Add(model => model.User.NIF).Titled(@Html.DisplayNameFor(model => model.User.NIF));
        columns.Add(model => model.PhoneNumber).Titled(@Html.DisplayNameFor(model => model.PhoneNumber));
        columns.Add(model => model.Email).Titled(@Html.DisplayNameFor(model => model.Email));
        columns.Add(model => model.Profile.Name).Titled(@Html.DisplayNameFor(model => model.Profile));
        columns.Add(model => $@"
            <div class=""btn-group"" role=""group"">
                <a role=""button""
                   class=""btn btn-warning""
                   href=""{Url.Action("Edit", "Employee", new { id = model.Id })}"">
                    Editar
                </a>
                <a role=""button""
                   class=""btn btn-danger""
                   href=""{Url.Action("Delete", "Employee", new { id = model.Id })}"">
                    Apagar
                </a>
            </div>
        ")
        .Encoded(false);
    })
    .Filterable(GridFilterCase.Lower)
    .Using(GridFilterMode.Header)
    .Empty("No data found")
    .Pageable(pager =>
    {
        pager.RowsPerPage = 4;
    })
    .Sortable()
    )
</div>
