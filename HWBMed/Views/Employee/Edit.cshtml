@model HWBMed.Models.ViewModel.EmployeeCreateViewModel
@{
    ViewData["Title"] = "Edit Employee";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        <button type="button" class="btn btn-close btn-sm close-alert" aria-label="Close alert"></button>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMenssage"] != null)
{
    <div class="alert alert-danger" role="alert">
        <button type="button" class="btn btn-close btn-sm close-alert" aria-label="Close alert"></button>
        @TempData["ErrorMenssage"]
    </div>
}
<div class="text-center">
    <h1 class="display-4">@ViewData["Title"]</h1>
</div>
<form asp-controller="Employee" asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" class="form-control" asp-for="Id">
    <input type="hidden" class="form-control" asp-for="UserID">
    <input type="hidden" class="form-control" asp-for="NIF">
    <input type="hidden" class="form-control" asp-for="Name">
    <div class="input-group mb-3">
        <label asp-for="PhoneNumber" class="input-group-text"></label>
        <input type="text" class="form-control" asp-for="PhoneNumber">        
        <span asp-validation-for="PhoneNumber" class="input-group-text text-danger"></span>
    </div>
    <div class="input-group mb-3">
        <label asp-for="Email" class="input-group-text"></label>
        <input type="text" class="form-control" asp-for="Email">
        <span asp-validation-for="Email" class="input-group-text text-danger"></span>
    </div>
    <div class="input-group mb-3">
        <label asp-for="Password" class="input-group-text"></label>
        <input type="text" class="form-control" asp-for="Password">
        <span asp-validation-for="Password" class="input-group-text text-danger"></span>
    </div>
    <div class="input-group mb-3">
        <label asp-for="ProfileID" class="input-group-text"></label>
        <select class="form-control" asp-for="ProfileID" asp-items="ViewBag.Profiles"></select>
        <span asp-validation-for="ProfileID" class="input-group-text text-danger"></span>
    </div>
    <div class="mb-3 d-grid gap-2">
        <button type="submit" class="btn btn-primary">Edit</button>
        <a class="btn btn-secondary" role="button" asp-controller="User" asp-action="Index">List Employee</a>
    </div>
</form>
