@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@inject IOptions<RequestLocalizationOptions> locOptions;
@inject IHtmlLocalizer<SharedResource> SharedLocalizer;
@{
    var supportedCultures = locOptions.Value.SupportedUICultures!
                            .Select(c => new SelectListItem { Value = c.Name, Text = c.DisplayName })
                            .ToList();
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
}
<ul class="navbar-nav select-language">
    <li class="nav-item">
        <div class="form">
            <form id="selectLinguage" asp-controller="Home" asp-action="SetLinguage"
                  asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"                    
                  method="post"
                  class="form-horizontal row"
                  role="form"> 
                <div class="col-md-6 text-end">@SharedLocalizer["Language:"]</div>
                <div class="col-md-6">
                    <select class="form-control" name="culture" onchange="this.form.submit();"
                            asp-for="@requestCulture!.RequestCulture.UICulture.Name"
                            asp-items="supportedCultures">
                    </select>
                </div>
            </form>
        </div>
    </li>
</ul>