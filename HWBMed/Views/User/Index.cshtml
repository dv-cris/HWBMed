@model IEnumerable<HWBMed.Models.User>

@{
    ViewData["Title"] = "User list";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        <button type="button" class="btn btn-close btn-sm close-alert" aria-label="Close alert"></button>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        <button type="button" class="btn btn-close btn-sm close-alert" aria-label="Close alert"></button>
        @TempData["ErrorMessage"]
    </div>
}

<div class="text-center">
    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
        <a class="btn btn-primary" role="button" asp-controller="User" asp-action="Create">Create</a>
    </div>
    <br />
    <h1 class="display-4">@ViewData["Title"]</h1>

    @(Html
    .Grid(Model)
    .Build(columns =>
    {
        columns.Add(model => model.Id).Titled(@Html.DisplayNameFor(model => model.Id));
        columns.Add(model => model.Name).Titled(@Html.DisplayNameFor(model => model.Name));
        columns.Add(model => model.BirthDate).Titled(@Html.DisplayNameFor(model => model.BirthDate));
        columns.Add(model => model.Address).Titled(@Html.DisplayNameFor(model => model.Address));
        columns.Add(model => model.Local).Titled(@Html.DisplayNameFor(model => model.Local));
        columns.Add(model => model.PostalCode).Titled(@Html.DisplayNameFor(model => model.PostalCode));
        columns.Add(model => model.NIF).Titled(@Html.DisplayNameFor(model => model.NIF));
        columns.Add(model => model.UtenteNumber).Titled(@Html.DisplayNameFor(model => model.UtenteNumber));
        columns.Add(model => model.PhoneNumber).Titled(@Html.DisplayNameFor(model => model.PhoneNumber));
        columns.Add(model => model.Email).Titled(@Html.DisplayNameFor(model => model.Email));
        columns.Add(model => model.ContactPhone).Titled(@Html.DisplayNameFor(model => model.ContactPhone));
        columns.Add(model => model.ContactEmail).Titled(@Html.DisplayNameFor(model => model.ContactEmail));
        columns.Add(model => $@"
            <div class=""btn-group"" role=""group"">
                <a role=""button""
                   class=""btn btn-success""
                   href=""{Url.Action("Create", "Employee", new { NIF = model.NIF })}"">
                    Create login
                </a>

                <a role=""button""
                   class=""btn btn-warning""
                   href=""{Url.Action("Edit", "User", new { id = model.Id })}"">
                    Editar
                </a>

                <a role=""button""
                   class=""btn btn-danger""
                   href=""{Url.Action("Delete", "User", new { id = model.Id })}"">
                    Apagar
                </a>
            </div>
        ")
        .Encoded(false);
    })
    .Filterable(GridFilterCase.Lower)
    .Using(GridFilterMode.Header)
    .Empty("No data found")
    .Pageable(pager =>
    {
        pager.RowsPerPage = 4;
    })
    .Sortable()
)
</div>
