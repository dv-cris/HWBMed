@model HWBMed.Models.Service
@{
    ViewData["Title"] = "Service Delete";
}
<div class="text-center">
    <div class="card">
        <div class="card-header">
            <h1 class="display-4">@ViewData["Title"]</h1>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Name)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Name)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Price)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Price)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.IVA)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.IVA)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Area)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Area.Name)
                </dd>
            </dl>
        </div>
    </div>
</div>
<br />
<div class="mb-3 d-grid gap-2">
    <a class="btn btn-primary" asp-controller="Service" asp-action="Index" role="button">Cancel</a>
    <form class="d-grid" asp-controller="Service" asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger" asp-controller="Service" asp-action="ExeDelete">Confirm</button>
    </form>

</div>