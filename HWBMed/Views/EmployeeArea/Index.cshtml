@model IEnumerable<HWBMed.Models.EmployeeArea>

@{
    ViewData["Title"] = "Employee Area list";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        <button type="button" class="btn btn-close btn-sm close-alert" aria-label="Close alert"></button>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMenssage"] != null)
{
    <div class="alert alert-danger" role="alert">
        <button type="button" class="btn btn-close btn-sm close-alert" aria-label="Close alert"></button>
        @TempData["ErrorMenssage"]
    </div>
}

<div class="text-center">
    <br />
    <h1 class="display-4">@ViewData["Title"]</h1>

    @(Html
    .Grid(Model)
    .Build(columns =>
    {
        columns.Add(model => model.Employee.User.Email).Titled(@Html.DisplayNameFor(model => model.Employee.User.Email));
        columns.Add(model => model.Employee.User.Name).Titled(@Html.DisplayNameFor(model => model.Employee.User.Name));
        columns.Add(model => model.Area.Name).Titled(@Html.DisplayNameFor(model => model.Area.Name));
        columns.Add(model => $@"
            <div class=""btn-group"" role=""group"">
                <a role=""button""
                   class=""btn btn-warning""
                   href=""{Url.Action("Edit", "EmployeeArea", new { id = model.Id })}"">
                    Editar
                </a>
                <a role=""button""
                   class=""btn btn-danger""
                   href=""{Url.Action("Delete", "EmployeeArea", new { id = model.Id })}"">
                    Apagar
                </a>
            </div>
        ")
        .Encoded(false);
    })
    .Filterable(GridFilterCase.Lower)
    .Using(GridFilterMode.Header)
    .Empty("No data found")
    .Pageable(pager =>
    {
        pager.RowsPerPage = 4;
    })
    .Sortable()
    )
</div>
